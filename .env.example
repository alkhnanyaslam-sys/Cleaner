# ==== Telegram ====
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# ==== Database ====
DATABASE_URL=database/bot.db

# ==== Limits ====
MAX_FILE_SIZE_MB=50
MAX_DURATION_SECONDS=600
MAX_WORKERS=1
MAX_CONCURRENT_PER_USER=1
MAX_JOBS_PER_USER_DAILY=10

# ==== AI Model ====
MODEL_NAME=htdemucs

# ==== Storage ====
TEMP_DIR=temp
RESULT_TTL_MINUTES=30

# ==== Runtime ====
# How long the bot polling loop should run before exiting gracefully
# (used for the GitHub Actions restart-every-6-hours strategy)
RUN_DURATION_MINUTES=350
